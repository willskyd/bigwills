# Backend forwarding destination for /api/contact (recommended: full URL)
# Example: https://v0-latest-torqtech-dashboard.vercel.app/api/notifications
CONTACT_API_URL=

# Optional alternatives:
# CONTACT_WEBHOOK_URL=
# BACKEND_CONTACT_URL=
# CONTACT_API_URLS=        # comma-separated full URLs
# CONTACT_FORWARD_HEADERS_JSON={"Cookie":"session=...","x-api-key":"..."}
# BASE_URL=               # full endpoint OR backend base URL
# API_BASE=               # full endpoint OR backend base URL
# BACKEND_URL=            # backend base URL (CONTACT_API_PATH will be appended)
# BACKEND_BASE_URL=       # backend base URL (CONTACT_API_PATH will be appended)
# CONTACT_API_PATH=/api/contact
# CONTACT_API_PATHS=/api/contacts,/api/inquiries,/api/contact

# Auth options used by app/api/contact/route.js
# 1) Legacy simple token:
API_KEY=
# API_KEY_HEADER=Authorization

# 2) JSON credential auth (recommended for JSON key objects)
# Provide either a stringified JSON or a file path:
API_KEY_JSON=
# SERVICE_ACCOUNT_FILE=./service-account.json

# How to apply credential token to outbound request:
# API_AUTH_MODE=none | api_key_header | bearer_token_field | json_body
API_AUTH_MODE=api_key_header
# Field path inside JSON object used as token (supports dot paths):
API_KEY_JSON_FIELD=apiKey
# Header/body options:
# API_KEY_HEADER=Authorization
# API_AUTH_BODY_FIELD=apiKey
